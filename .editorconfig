root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Pages, styles and the Worker use 4 spaces; do not reflow them for style reasons.
[*.md]
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml}]
indent_size = 2
